# n8n version - get the version number of the latest stable release from https://github.com/n8n-io/n8n/releases
N8N_VERSION=

# Sandbox service version - the API, runner, and sandbox images share one release.
N8N_SANDBOX_VERSION=

# n8n task runner authentication. Use a random secret.
N8N_RUNNERS_AUTH_TOKEN=

# Sandbox service secrets
SANDBOX_API_KEYS=
SANDBOX_API_RUNNER_REGISTRATION_TOKEN=
SANDBOX_RUNNER_API_KEY=
N8N_SANDBOX_SERVICE_API_KEY=

# Web search secret and URL
SEARXNG_SECRET=
N8N_INSTANCE_AI_SEARXNG_URL=
N8N_CORS_ALLOW_ORIGIN=http://localhost:8088
